# Backend the dev server proxies /api to (backend: uvicorn api.app:app --app-dir backend --port 8000)
VITE_API_TARGET=http://localhost:8000
# Production: public HTTPS URL of the separately hosted FastAPI backend; no trailing slash.
# Set this in the Vercel project before building, for example:
# VITE_API_BASE_URL=https://api.example.com
# Only affects the old chat UI at /#chat: "true" answers it with a built-in mock
VITE_USE_MOCK=false
