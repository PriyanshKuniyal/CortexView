# Copy to backend/.env (never commit .env). Real environment variables override these.

# Upload cap in MB; 0 = no cap (demo default)
MAX_UPLOAD_MB=0
# Primary segmenter: ai (default) or classical. AI uses the supplied 3D nnU-Net T1 model.
CORTEXVIEW_SEGMENTER=ai
# Override only when replacing the supplied model with another nnU-Net inference folder.
CORTEXVIEW_AI_WEIGHTS=C:\Users\Priyansh Kuniyal\Plie-seg-ai\ml\weights\cortexview_nnunet
# Frontend origins allowed to call the API directly (the Vite dev server proxies /api, so this is a fallback)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Render chain, tried in order: cache, local (FT's LoRA via Cloudflare Tunnel), workers (Workers AI), flat
RENDER_BACKENDS=cache,local,workers,flat
RENDER_ATTEMPTS=3
RENDER_TIMEOUT_S=30
RENDER_DEADLINE_S=45
RENDER_SIZE=768

# FT's LoRA server (finetune guide D4). Leave empty to skip.
LOCAL_RENDER_URL=
LOCAL_RENDER_KEY=

# Cloudflare Workers AI. Leave empty to skip. The existing CF_ACCOUNT_ID + CF_API_TOKEN pair is tried first.
# Extra rotating lists are then matched by position: CF_ACCOUNT_IDS[0] goes with CF_API_TOKENS[0], etc.
# A length mismatch disables Workers safely and continues to the normal fallback chain.
# CF_MODEL: workers-klein-4b (fast) | workers-klein-9b | workers-flux2-dev (32B, slower, billed per step)
CF_ACCOUNT_ID=
# Extra paired rotation. Every token must have Workers AI permission for its matching account.
CF_ACCOUNT_IDS=
CF_API_TOKENS=
# First account + token pair (keep your already-configured values here).
CF_API_TOKEN=
CF_MODEL=workers-klein-4b
# Steps for workers-flux2-dev only (klein is fixed at 4)
RENDER_STEPS=20

# Fidelity gate: minimum mean IoU and maximum fake-lesion % (of intracranial pixels)
FIDELITY_MIN_IOU=0.4
FIDELITY_MAX_PHANTOM_PCT=0.5

# Demo cache: illustrations saved by guide hash. Set RECORD=1 while running the demo cases once
# with a working AI backend; afterwards the demo works offline. Default dir: data/render_cache/
RENDER_CACHE_DIR=
RENDER_CACHE_RECORD=0
